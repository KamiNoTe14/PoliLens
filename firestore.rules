rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anonymous submissions: create-only, strict shape, never readable by clients.
    match /responses/{id} {
      allow create: if request.resource.data.keys().hasOnly(['v', 'a', 'st'])
        && request.resource.data.v == 1
        && request.resource.data.a is string
        && request.resource.data.a.matches('^[0-4x]{26}$')
        && (!('st' in request.resource.data)
            || (request.resource.data.st is string && request.resource.data.st.matches('^[A-Z]{2}$')));
      allow read, update, delete: if false;
    }

    // Aggregates are written only by the tally job (admin SDK bypasses rules).
    match /stats/{doc} {
      allow read: if true;
      allow write: if false;
    }
  }
}
